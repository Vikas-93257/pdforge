{
  "name": "pdforge",
  "version": "1.7.0",
  "private": true,
  "description": "Free, private, browser-based PDF tools. Static hosting. No document uploads.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/assets.mjs && node scripts/licenses.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "npm run fixtures && tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:browser": "npm run fixtures && playwright test --project=chromium",
    "test:site": "node scripts/check-site.mjs",
    "audit:seo": "node scripts/lighthouse.mjs",
    "verify": "node scripts/verify.mjs",
    "fixtures": "tsx scripts/fixtures.mts",
    "pdforge": "tsx cli/pdforge.ts",
    "test:independent": "tsx scripts/independent.mts",
    "test:cross-browser": "npm run fixtures && playwright test",
    "format": "prettier --write src scripts tests *.ts *.mjs package.json tsconfig.json .github docs README.md SECURITY.md CHANGELOG.md",
    "format:check": "prettier --check src scripts tests *.ts *.mjs package.json tsconfig.json .github docs README.md SECURITY.md CHANGELOG.md",
    "test:base-path": "npm run fixtures && node scripts/check-base-path.mjs",
    "examples": "tsx scripts/public-examples.mts",
    "indexnow": "tsx scripts/indexnow.mts"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.14.0",
    "dompurify": "3.4.17",
    "html2canvas": "1.4.1",
    "jszip": "3.10.2",
    "lucide-react": "1.61.0",
    "mammoth": "1.13.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "regenerator-runtime": "0.14.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@napi-rs/canvas": "1.0.13",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "lighthouse": "13.5.0",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.31"
  },
  "type": "module"
}
