# Public build-time values only; never put secrets in NEXT_PUBLIC_*.
# The source repository is private. Do not expose private source URLs in the app.
# GitHub Pages workflow derives the public site URL and path automatically.
# NEXT_PUBLIC_SITE_URL=https://vikas-93257.github.io/pdforge
# NEXT_PUBLIC_BASE_PATH=/pdforge
NEXT_TELEMETRY_DISABLED=1

# Optional PUBLIC webmaster verification values only, copied from the official tool.
# Never use an OAuth token, payment secret or private API key here.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
